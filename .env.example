# CareHomeOS local environment
# Copy this file to .env and fill the blank values. Do not commit real secrets.

# Core app
APP_NAME="CareHomeOS API"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8105
API_V1_PREFIX=/api/v1
PUBLIC_API_PREFIX=/api/v1/public
ENABLE_DOCS=true
DEFAULT_NATION=england
ENABLE_AI_FEATURES=true

# Public local URLs
PUBLIC_API_BASE_URL=https://carehomeos-api.localtest.me
PUBLIC_DASHBOARD_URL=https://carehomeos.localtest.me
NEXT_PUBLIC_API_BASE_URL=https://carehomeos-api.localtest.me
EXPO_PUBLIC_API_URL=https://carehomeos-api.localtest.me
EXPO_PUBLIC_API_BASE_URL=https://carehomeos-api.localtest.me/api/v1
ALLOWED_ORIGINS=["http://localhost:3105","http://localhost:19015","http://localhost:19016","https://carehomeos.localtest.me"]

# Local ports
CAREHOMEOS_DASHBOARD_PORT=3105
CAREHOMEOS_API_PORT=8105
CAREHOMEOS_MOBILE_WEB_PORT=19015
CAREHOMEOS_FAMILY_WEB_PORT=19016
POSTGRES_PORT=5435
REDIS_PORT=6385
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MAILHOG_SMTP_PORT=1026
MAILHOG_UI_PORT=8026

# Database and cache
DATABASE_URL=postgresql+asyncpg://carehomeos:carehomeos@localhost:5435/carehomeos
REDIS_URL=redis://localhost:6385/0

# S3-compatible local storage. Defaults match docker-compose MinIO.
AWS_REGION=eu-west-2
S3_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_CLINICAL=clinical-documents
S3_BUCKET_AUDIO=audio-temp

# Multi-LLM routing
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_DEEP_MODEL=claude-opus-4-5
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# Multilingual voice-note translation
DEEPL_API_KEY=

# Auth0 dashboard/API login
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Optional. Leave blank to use the URL you opened in the browser.
AUTH0_BASE_URL=

# Billing and email
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=

# Public API settings
PUBLIC_API_RATE_LIMIT=1000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_SECONDS=60

# Pharmacy integration settings
TITAN_API_URL=
TITAN_API_KEY=
RXWEB_API_URL=
RXWEB_API_KEY=

# NHS integration settings
GP_CONNECT_ENABLED=false
GP_CONNECT_ENDPOINT=
GP_CONNECT_CLIENT_ID=
GP_CONNECT_CLIENT_SECRET=
SPINE_ENDPOINT=
PDS_ENABLED=false

# Compliance settings
ISO27001_CERTIFIED=false
CYBER_ESSENTIALS_CERTIFIED=false
DSPT_COMPLIANT=false
DCB0129_COMPLIANT=false

# Billing / Pricing settings
FREE_TIER_MAX_RESIDENTS=5
FREE_TIER_MAX_CARE_NOTES_PER_DAY=20
TRIAL_DAYS=90
GROUP_DISCOUNT_RATE=0.20
RI_DISCOUNT_RATE=0.50
RI_DISCOUNT_MONTHS=6
