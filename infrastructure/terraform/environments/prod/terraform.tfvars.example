project_name         = "carehomeos"
environment          = "prod"
aws_region           = "eu-west-2"
vpc_cidr             = "10.40.0.0/16"
availability_zones   = ["eu-west-2a", "eu-west-2b"]
backend_image        = "123456789012.dkr.ecr.eu-west-2.amazonaws.com/carehomeos-prod-backend:latest"
dashboard_image      = "123456789012.dkr.ecr.eu-west-2.amazonaws.com/carehomeos-prod-dashboard:latest"
public_api_base_url  = "https://api.carehomeos.example.com"
public_dashboard_url = "https://carehomeos.example.com"
database_url         = "postgresql+asyncpg://username:password@db.prod.carehomeos.internal:5432/carehomeos"
redis_url            = "redis://cache.prod.carehomeos.internal:6379/0"
s3_bucket_clinical   = "carehomeos-prod-clinical"
s3_bucket_audio      = "carehomeos-prod-audio"
enable_docs          = false
allowed_origins      = ["https://carehomeos.example.com"]
