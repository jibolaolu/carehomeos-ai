project_name         = "carehomeos"
environment          = "staging"
aws_region           = "eu-west-2"
vpc_cidr             = "10.30.0.0/16"
availability_zones   = ["eu-west-2a", "eu-west-2b"]
backend_image        = "123456789012.dkr.ecr.eu-west-2.amazonaws.com/carehomeos-staging-backend:latest"
dashboard_image      = "123456789012.dkr.ecr.eu-west-2.amazonaws.com/carehomeos-staging-dashboard:latest"
public_api_base_url  = "https://api.staging.carehomeos.example.com"
public_dashboard_url = "https://staging.carehomeos.example.com"
database_url         = "postgresql+asyncpg://username:password@db.staging.carehomeos.internal:5432/carehomeos"
redis_url            = "redis://cache.staging.carehomeos.internal:6379/0"
s3_bucket_clinical   = "carehomeos-staging-clinical"
s3_bucket_audio      = "carehomeos-staging-audio"
enable_docs          = false
allowed_origins      = ["https://staging.carehomeos.example.com"]
